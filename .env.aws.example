# Copy to .env.aws on the EC2 host, then replace every placeholder.
AWS_REGION=eu-north-1
ECR_REGISTRY=ACCOUNT_ID.dkr.ecr.eu-north-1.amazonaws.com
IMAGE_TAG=release-1

# Use the private RDS endpoint and URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://DB_USER:URL_ENCODED_PASSWORD@RDS_ENDPOINT:5432/DB_NAME?sslmode=require
GROQ_API_KEY=replace-with-the-Groq-key
JWT_SECRET_KEY=replace-with-a-new-random-secret
COOKIE_SECURE=true
